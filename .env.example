# Copy to .env (gitignored). The shared DB is Supabase Postgres (Session pooler URL, see README);
# the localhost:5433 default is the throwaway Docker Postgres for local experiments / CI.
DATABASE_URL=postgresql+psycopg://lazysleeper:lazysleeper@localhost:5433/lazysleeper

# Local raw-snapshot archive (gz JSON). Mirrored to Supabase Storage when configured.
SNAPSHOT_DIR=./data/snapshots

# Supabase (optional until hosted). Server-side sb_secret_... key from Project Settings → API Keys.
# The publishable key is NOT needed here — clients talk to FastAPI, never to Supabase directly. Never commit.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=raw-snapshots

# The League (2026)
SLEEPER_LEAGUE_ID=1392685475625443328
SLEEPER_DRAFT_ID=1392685476523024384
SLEEPER_USER_ID=1268591266036203520
