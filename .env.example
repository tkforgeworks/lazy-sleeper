# Copy to .env (gitignored). Local Docker Postgres by default; swap DATABASE_URL for Supabase.
DATABASE_URL=postgresql+psycopg://lazysleeper:lazysleeper@localhost:5433/lazysleeper

# Local raw-snapshot archive (gz JSON). Mirrored to Supabase Storage when configured.
SNAPSHOT_DIR=./data/snapshots

# Supabase (optional until hosted). Service-role key — never commit.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=raw-snapshots

# The League (2026)
SLEEPER_LEAGUE_ID=1392685475625443328
SLEEPER_DRAFT_ID=1392685476523024384
SLEEPER_USER_ID=1268591266036203520
